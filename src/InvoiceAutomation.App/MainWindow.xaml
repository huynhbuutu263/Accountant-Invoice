<Window x:Class="InvoiceAutomation.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    mc:Ignorable="d"
    Title="Invoice automation"
    Height="560"
    Width="920"
    MinHeight="400"
    MinWidth="640">
<Grid Margin="16">
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="3*" />
        <RowDefinition Height="10*" />
        <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ProgressBar Width="200"
                    Height="18"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    IsIndeterminate="{Binding IsRunning}"
                    Value="{Binding Progress}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>


            <GroupBox Grid.Column="0" Header="Parameters" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Visibility="Collapsed" Grid.Row="0" Grid.Column="0" Text="From" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <DatePicker Visibility="Collapsed" Grid.Row="0" Grid.Column="1" SelectedDate="{Binding FromDate}" Margin="0,4" />
                    <TextBlock Visibility="Collapsed" Grid.Row="1" Grid.Column="0" Text="To" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <DatePicker Visibility="Collapsed" Grid.Row="1" Grid.Column="1" SelectedDate="{Binding ToDate}" Margin="0,4" />
                    <TextBlock Visibility="Collapsed" Grid.Row="2" Grid.Column="0" Text="Invoice kind" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <ComboBox Visibility="Collapsed" Grid.Row="2" Grid.Column="1"
                    Margin="0,4"
                    ItemsSource="{Binding InvoiceKindOptions}"
                    SelectedItem="{Binding InvoiceKind}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Flow JSON" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FlowPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Downloads" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DownloadsRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <TextBlock Visibility="Collapsed" Grid.Row="5" Grid.Column="0" Text="MST (username)" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <TextBox Visibility="Collapsed" Grid.Row="5" Grid.Column="1" Text="{Binding GdtMst, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <TextBlock Visibility="Collapsed" Grid.Row="6" Grid.Column="0" Text="Password" Margin="0,4,12,4" VerticalAlignment="Center" />
                    <PasswordBox Visibility="Collapsed" Grid.Row="6" Grid.Column="1" x:Name="PasswordInput" Margin="0,4" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,0,0,12">
                <Button Visibility="Collapsed" Content="Start"
            Margin="0,0,0,8"
            Padding="12,8"
            Command="{Binding StartCommand}" />
                <Button Visibility="Collapsed" Content="Cancel"
            Margin="0,0,0,8"
            Padding="12,8"
            Command="{Binding CancelCommand}" />
                <Button Content="Open Browser"
            Margin="0,0,0,8"
            Padding="12,8"
            Command="{Binding OpenGdtPortalCommand}"
            ToolTip="Opens the browser and navigates to hoadondientu.gdt.gov.vn" />
                <Button Content="Download"
            Margin="0,0,0,8"
            Padding="12,8"
            Command="{Binding DownloadOnlyCommand}"
            ToolTip="Loops each table row: click row → download XML (run after Tìm kiếm shows results)" />
                <Button Visibility="Collapsed" Content="Test login flow"
            Padding="12,8"
            Command="{Binding TestLoginCommand}"
            ToolTip="Runs the flow configured as Flows:LoginPath" />
            </StackPanel>

        </Grid>

    
    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Grid.ColumnSpan="3" Header="Log" Padding="0" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding Logs}"
            FontFamily="Consolas"
            FontSize="12"
            Margin="8" />
        </GroupBox>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
        Margin="5">

                <Button Content="Load Invoice XML"
                        Width="150"
                        Command="{Binding LoadDataCommand}"
                        />

                <TextBox x:Name="txtSearch"
                         Text="{Binding InvoiceXMLDataPath, UpdateSourceTrigger=PropertyChanged}"
                    Width="250"
                    Margin="10,0,0,0"/>
            </StackPanel>

                <DataGrid Grid.Row="1"
              Margin="5"
              ItemsSource="{Binding Invoices}"
              SelectedItem="{Binding SelectedInvoice}"
              IsReadOnly="True"
              AutoGenerateColumns="False">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction
                    Command="{Binding OpenInvoiceCommand}"
                    CommandParameter="{Binding SelectedItem,
                        RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"
                                Width="120"
                                Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy}" />

                        <DataGridTextColumn Header="File Path"
                                Width="*"
                                Binding="{Binding FilePath}" />

                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
    </Grid>


    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
        TextWrapping="Wrap"
        Foreground="#666"
        FontSize="11"
        Text="Automation steps are defined in JSON under flows/. Install Playwright once: run install-playwright.cmd in the app folder (avoids PowerShell script policy errors)." />


</Grid>
</Window>
